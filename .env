# Project Configuration
PROJECT_NAME="Colour Labs CRM"
ENV=development
API_V1_STR=/api/v1

# CORS Settings (JSON-parsed array of origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=colourlabs_crm

# Frontend configuration
VITE_API_BASE_URL=http://localhost:8000

# Google Maps / Places lead collection (provider key: google_maps)
# Leave GOOGLE_MAPS_API_KEY empty to keep the provider disabled; it then reports itself
# unavailable and refuses to run instead of failing mid-import against Google.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_REGION=in
GOOGLE_MAPS_LANGUAGE=en
GOOGLE_MAPS_FETCH_DETAILS=true
GOOGLE_MAPS_TIMEOUT_SECONDS=15
GOOGLE_MAPS_MAX_PAGES=3

# Instagram lead collection (provider key: instagram)
# Uses the Instagram Graph API's Business Discovery, which requires BOTH a long-lived
# access token AND the IG Business account id the lookups are issued as. Leave either
# empty to keep the provider disabled; it then reports itself unavailable and refuses to
# run instead of failing mid-import against Meta.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_API_VERSION=v21.0
INSTAGRAM_TIMEOUT_SECONDS=15
INSTAGRAM_MAX_PAGES=3
INSTAGRAM_CONCURRENCY=5
INSTAGRAM_REQUIRE_CONTACT=true
INSTAGRAM_MIN_FOLLOWERS=0
